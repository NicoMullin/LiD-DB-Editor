{
  "id": "Quest Limit",
  "name": "Quest Limit",
  "description": "Accept up to {{quests}} quests at once instead of 10. Set it in Configuration.",
  "version": "0.1.0",
  "author": "KSFA",
  "category": "Quality of life",
  "tags": ["quests", "limit", "game-files"],
  "game_version": ["5.0.4.4.0 - 1.91"],
  "requires": [],
  "conflicts_with": [],
  "requires_check_off": ["BrgGame.upk"],
  "settings": [
    {
      "id": "quests",
      "label": "Quests at once",
      "type": "integer",
      "default": 20,
      "min": 1,
      "max": 99,
      "help": "The game ships with 10. This is how many quests the quest board lets you have accepted at the same time."
    }
  ],
  "patches": [
    {
      "type": "package_bytes",
      "id": "quest-limit",
      "description": "Most quests accepted at once: {{quests}}",
      "target": "BrgGame/CookedPCConsole/BrgGame.upk",
      "edits": [
        {
          "name": "Most quests accepted",
          "find": [
            {"hex": "e9be0000 00000000"},
            {"hex": "367a0000 00000000"},
            {"hex": "04000000 00000000"}
          ],
          "write": {"type": "i32", "value": "{{quests}}"}
        }
      ]
    }
  ]
}
