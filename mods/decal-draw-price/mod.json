{
  "id": "decal-draw-price",
  "name": "Decal Draw Price",
  "description": "A draw from the Mushroom Club's decal pool costs {{price:comma}} KC instead of 50,000.",
  "version": "2.0.0",
  "author": "KSFA",
  "game_version": ["5.0.3.0.0 - 1.87", "5.0.4.0.0 - 1.88"],
  "requires": [],
  "conflicts_with": [],
  "settings": [
    {
      "id": "price",
      "label": "Price",
      "type": "integer",
      "default": 10000,
      "min": 1,
      "max": 1000000,
      "step": 1000,
      "unit": "KC",
      "help": "The stock price is 50,000 KC."
    }
  ],
  "patches": [
    {
      "type": "update_set",
      "description": "PRD_SKILL_GACHA price 50,000 -> {{price:comma}} KC",
      "table": "master_shop_product_price",
      "set": {
        "price": "{{price}}"
      },
      "where": "id = 'PRD_SKILL_GACHA'"
