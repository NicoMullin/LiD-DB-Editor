__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.spec

# Release archives built locally
*.7z
*.zip
*.rar

# Design notes, not part of the release
BRAINSTORM.md

# Mods by other authors - kept locally, not redistributed from this repo
mods/Floor Material Names/
mods/Shop Always Appears/

# Throwaway mods that exist to demonstrate a feature, not to be shipped
mods/overlap-test/
mods/diff-demo-blunt/
mods/diff-demo-tweak/

# Generated thumbnails of artwork the user supplied - never redistributed
icon-cache/

# Runtime state - each user's own
state.json
state.json.corrupt
snapshots/
logs/
backups/
*.db
*.db.backup
*.db.original

# The clean reference copies of the game's database, one per game build. These
# are the exception to the *.db rule above: everything else matching it is a
# working copy or a backup belonging to whoever is running the tool.
!LiD Vanilla DB/**/*.db

# Store-page copy for other sites, not part of the release
nexus-description.txt


# Personal game saves - player name and account id inside, never published
Save file json/
*.bak-*

# Tool caches
.pytest_cache/
.ruff_cache/

# Reference material from other projects - read, not redistributed
resrourse files/
resource files/
